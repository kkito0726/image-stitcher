# docker-compose.deploy.yml 用の設定。`cp .env.deploy.example .env` して値を埋める。
# .env は秘密情報を含むためコミットしないこと (.gitignore 済み)。

# --- 必須 ---
# Cloudflare Zero Trust > Networks > Tunnels で作成したトンネルのトークン
TUNNEL_TOKEN=

# --- ダウンロード ---
# フル解像度ダウンロードは既定で JPEG。PNG (無劣化) は利用者が明示的に選んだ場合のみ
DOWNLOAD_JPEG_QUALITY=95

# --- 機種別のリソース設定 ---
# Intel N100 (16GB) で Minecraft サーバーと同居させる構成 (現行)
# Minecraft に CPU 2 コア強とメモリ約 10GB を残す。単独運用の値は docs を参照
# (合成結果はダウンロード用にメモリ保持する。実測で 6 枚合成 1 件 ≈ 34MB、枚数に応じて増える)
BACKEND_CPUS=2.0
BACKEND_MEMORY=3G
RESULT_CACHE_MAX_ENTRIES=3
RESULT_CACHE_TTL_SECONDS=600
STITCH_MAX_IMAGES=15

# 1 リクエストの画像の合計画素数の上限 (既定 4000 万画素)。合成のピークメモリは実測で
# 重なりの大きい実写 6 枚 (2592x1728) で約 15〜18 バイト/画素、重なりの少ない最悪ケースで
# 約 30 バイト/画素なので、BACKEND_MEMORY 3G ではこの程度に抑える。枚数上限とは別にかかり、
# 2592x1728 (約 450 万画素) の画像なら 13 枚まで (上の STITCH_MAX_IMAGES=15 より先に効く)。
STITCH_MAX_TOTAL_PIXELS=60000000
# 1 枚あたりの画素数の上限 (既定 4000 万画素)。STITCH_MAX_TOTAL_PIXELS 以下にすること
# OPENCV_IO_MAX_IMAGE_PIXELS=40000000

# 設定値の決め方と機種別の推奨値は docs/deploy-resource-tuning.md を参照
# Raspberry Pi 5 (4GB) の場合は上をコメントアウトして以下を使う
# (メモリが少ないためキャッシュ件数と入力枚数を絞る。2592x1728 の画像なら 8 枚まで)
# BACKEND_CPUS=3.0
# BACKEND_MEMORY=2G
# RESULT_CACHE_MAX_ENTRIES=2
# RESULT_CACHE_TTL_SECONDS=300
# STITCH_MAX_IMAGES=15
# STITCH_MAX_TOTAL_PIXELS=40000000
