# docker-compose.deploy.yml 用の設定。`cp .env.deploy.example .env` して値を埋める。
# .env は秘密情報を含むためコミットしないこと (.gitignore 済み)。

# --- 必須 ---
# Cloudflare Zero Trust > Networks > Tunnels で作成したトンネルのトークン
TUNNEL_TOKEN=

# --- ダウンロード ---
# フル解像度ダウンロードは既定で JPEG。PNG (無劣化) は利用者が明示的に選んだ場合のみ
DOWNLOAD_JPEG_QUALITY=95

# --- 機種別のリソース設定 ---
# Raspberry Pi 5 (4GB): メモリが少ないためキャッシュ件数と入力枚数を絞る
# (合成結果はダウンロード用にメモリ保持する。実測で 6 枚合成 1 件 ≈ 34MB、枚数に応じて増える)
BACKEND_CPUS=3.0
BACKEND_MEMORY=2G
RESULT_CACHE_MAX_ENTRIES=2
RESULT_CACHE_TTL_SECONDS=300
STITCH_MAX_IMAGES=15

# Intel N100 (16GB) の場合は上をコメントアウトして以下を使う
# BACKEND_CPUS=3.5
# BACKEND_MEMORY=8G
# RESULT_CACHE_MAX_ENTRIES=4
# RESULT_CACHE_TTL_SECONDS=600
# STITCH_MAX_IMAGES=30
